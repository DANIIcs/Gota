      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't on your Mac and isn't open source, so the PDF may look different. For the exact layout, install it or turn on Microsoft Office in Settings → Engines."
          }
        }
      }
    },
