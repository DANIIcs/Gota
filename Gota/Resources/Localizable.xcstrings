      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound is the alert sound you chose in System Settings → Sound."
          }
        }
      }
    },
    "Empieza a arrastrar desde Finder o el Escritorio y luego pulsa la tecla. Suelta en el centro de la rueda para cancelar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start dragging from Finder or the Desktop, then press the key. Drop on the center of the wheel to cancel."
          }
        }
      }
    },
    "Esta copia de Gota no incluye su motor de Word.": {
      "localizations": {
